    {
      "id": "60f49569-175e-49de-9efc-748bbc81d9c8",
      "name": "Users",
      "description": {
        "content": "Users represent people or bots in a Notion workspace. Person users are human members of the workspace, while bot users represent API integrations. Use these endpoints to list users, retrieve specific users, or get information about the current bot integration.",
        "type": "text/plain"
      },
